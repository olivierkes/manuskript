msgid "Pandoc import"
msgstr "导入 Pandoc"

#: Import%2313
msgid ""
"<b>Info:</b> Manuskript can\n"
"                        import from <b>markdown</b> or <b>OPML</b>. Pandoc "
"will\n"
"                        convert your document to either (see option below), "
"and\n"
"                        then it will be imported in manuskript. One or the "
"other\n"
"                        might give better result depending on your "
"document.\n"
"                        <br/>&nbsp;"
msgstr ""
"<b>信息</b> Manuskript 能够\n"
"                        从 <b>markdown</b> 或者<b>OPML</b>导入。Pandoc 将会\n"
"                        将你的文档转化为其中的一个 (见下方选项)，然后\n"
"                        再将其导入 Manuskript。两者中的一个\n"
"                        效果不同，这取决于你的文档。\n"
"                        <br/>&nbsp;"

