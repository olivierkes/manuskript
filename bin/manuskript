#!/usr/bin/env python3
# -*- coding: utf-8 -*-

import gi

gi.require_version("Gtk", "3.0")
gi.require_version("Handy", "1")
gi.require_version('GdkPixbuf', '2.0')

from gi.repository import GObject, Gtk, Handy

Handy.init()

import os
import argparse
import sys

realpath = os.path.realpath(__file__)
app_path = os.path.join(os.path.dirname(realpath), '..')

sys.path.insert(1, app_path)
os.chdir(app_path)

from manuskript.ui import MainWindow

defaultProjectPath = os.path.join(os.getcwd(), "sample-projects/book-of-acts.msk")

parser = argparse.ArgumentParser(description="Open a Manuskript project")
parser.add_argument(
    "msk_path",
    nargs="?",
    help="Path to the .msk file to open"
)

args = parser.parse_args()

projectPath = os.path.abspath(args.msk_path) if args.msk_path else defaultProjectPath

if not os.path.exists(projectPath):
    print(f"Error: project path does not exist: {projectPath}")
    sys.exit(1)

window = MainWindow()
window.openProject(projectPath)
window.run()
