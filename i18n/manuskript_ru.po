#: Import%231
msgid "Markdown import"
msgstr "Markdown импорт"

#: Import%232
msgid ""
"<b>Info:</b> A very simple\n"
"                        parser that will go through a markdown document and\n"
"                        create items for each titles.<br/>&nbsp;"
msgstr ""
"<b>Информация:</b> Очень простой\n"
"                        парсер, который пройдет по документу markdown и\n"
"                        создаст элементы для каждого заголовка.<br/>&nbsp;"

#: Import%233
msgid "Folder import"
msgstr "Импорт папки"

#: Import%234
msgid ""
"<p><b>Info:</b> Imports a whole\n"
"                        directory structure. Folders are added as folders, "
"and\n"
"                        plaintext documents within (you chose which ones by "
"extension)\n"
"                        are added as scene.</p>\n"
"                        <p>Only text files are supported (not images, binary "
"or others).</p>"
msgstr ""
"<p><b>Информация:</b> Импортирует всю структуру каталогов. \n"
"                        Папки добавляются в виде папок, и текстовые "
"документы в них\n"
"                        (вы решили, какие из них по расширению)\n"
"                        добавляются в качестве сцены.</p>\n"
"                        <p>Поддерживаются только текстовые файлы (не "
"изображения, двоичный или другие).</p>"

#: Import%235
msgid "Include only those extensions:"
msgstr "Включить только эти расширения:"

#: Import%236
msgid "Comma separated values"
msgstr "Значения, разделенные запятыми"

#: Import%237
msgid "Sort items by name"
msgstr "Сортировка элементов по имени"

#: Import%238
msgid "Import folder then files"
msgstr "Импорт папки потом файлов"

#: Import%239
msgid "OPML Import"
msgstr "Импорт OPML"

#: Import%2310
msgid "File open failed."
msgstr "Файл открыть не удалось."

#: Import%2311
msgid "This does not appear to be a valid OPML file."
msgstr "Это не допустимый OPML файл."

#: Import%2312
msgid "Pandoc import"
msgstr "Импорт Pandoc"

#: Import%2313
msgid ""
"<b>Info:</b> Manuskript can\n"
"                        import from <b>markdown</b> or <b>OPML</b>. Pandoc "
"will\n"
"                        convert your document to either (see option below), "
"and\n"
"                        then it will be imported in manuskript. One or the "
"other\n"
"                        might give better result depending on your "
"document.\n"
"                        <br/>&nbsp;"
msgstr ""
"<b>Информация:</b> Manuskript может\n"
"                        импортировать из <b>markdown</b> или <b>OPML</b>. "
"Pandoc\n"
"                        может преобразовать ваш документ в любой из них (см. "
"ниже),\n"
"                        и тогда он будет импортирован в manuskript. Один или "
"другой\n"
"                        могут дать лучший результат, в зависимости от вашего "
"документа.\n"
"                        <br/>&nbsp;"

#: Import%2314
msgid "Import using:"
msgstr "Импортировать используя:"

#: Import%2315
msgid "Wrap lines:"
msgstr "Перенос строк:"

#: Import%2316
msgid ""
"<p>Should pandoc create\n"
"                        cosmetic / non-semantic line-breaks?</p><p>\n"
"                        <b>auto</b>: wraps at 72 characters.<br>\n"
"                        <b>none</b>: no line wrap.<br>\n"
"                        <b>preserve</b>: tries to preserves line wrap from "
"the\n"
"                        original document.</p>"
msgstr ""
"<p>Следует ли pandoc создать \n"
"                        косметические / не семантической разрывы?</p><p>\n"
"                        <b>авто</b>: разрывает на 72 символе.<br>\n"
"                        <b>нет</b>: без переноса строки.<br>\n"
"                        <b>сохранить</b>: старается сохранить разрывы строк "
"из\n"
"                        исходного документа.</p>"

