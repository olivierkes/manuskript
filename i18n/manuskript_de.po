#: Import%231
msgid "Markdown import"
msgstr "Markdown-Import"

#: Import%232
msgid ""
"<b>Info:</b> A very simple\n"
"                        parser that will go through a markdown document and\n"
"                        create items for each titles.<br/>&nbsp;"
msgstr ""
"<b>Info:</b> Ein sehr einfacher\n"
"                        Parser, der ein Markdown-Dokument durchläuft und\n"
"                        für jeden Titel eigene Einträge anlegt.<br/>&nbsp;"

#: Import%233
msgid "Folder import"
msgstr "Ordnerimport"

#: Import%234
msgid ""
"<p><b>Info:</b> Imports a whole\n"
"                        directory structure. Folders are added as folders, "
"and\n"
"                        plaintext documents within (you chose which ones by "
"extension)\n"
"                        are added as scene.</p>\n"
"                        <p>Only text files are supported (not images, binary "
"or others).</p>"
msgstr ""
"<p><b>Info:</b> Importiert eine ganze Verzeichnisstruktur.\n"
"                        Ordner werden als Ordner hinzugefügt, und Reintext-"
"Dokumente\n"
"                        (Sie wählen welche, entsprechend der Erweiterung) "
"werden als Szene\n"
"                        hinzugefügt.</p>\n"
"                        <p>Es werden nur Textdateien unterstützt (keine "
"Bilder, Binärdateien oder andere).</p>"

#: Import%235
msgid "Include only those extensions:"
msgstr "Nur diese Dateinamenerweiterungen hinzufügen:"

#: Import%236
msgid "Comma separated values"
msgstr "Komma-getrennte Werte"

#: Import%237
msgid "Sort items by name"
msgstr "Elemente nach Namen sortieren"

#: Import%238
msgid "Import folder then files"
msgstr "Erst Ordner, danach Dateien importieren"

#: Import%239
msgid "OPML Import"
msgstr "OPML importieren"

#: Import%2310
msgid "File open failed."
msgstr "Öffnen der Datei fehlgeschlagen."

#: Import%2311
msgid "This does not appear to be a valid OPML file."
msgstr "Dies scheint keine gültige OPML-Datei zu sein."

#: Import%2312
msgid "Pandoc import"
msgstr "Pandoc importieren"

#: Import%2313
msgid ""
"<b>Info:</b> Manuskript can\n"
"                        import from <b>markdown</b> or <b>OPML</b>. Pandoc "
"will\n"
"                        convert your document to either (see option below), "
"and\n"
"                        then it will be imported in manuskript. One or the "
"other\n"
"                        might give better result depending on your "
"document.\n"
"                        <br/>&nbsp;"
msgstr ""
"<b>Info:</b> Manuskript kann\n"
"                        <b>Markdown</b> oder <b>OPML</b> importieren. Pandoc "
"konvertiert\n"
"                        Ihr Dokument in das jeweilige Format, bevor\n"
"                        Manuskript es importiert. Das Ergebnis\n"
"                        hängt von der Art Ihres Dokuments ab.\n"
"                        <br/>&nbsp;"

#: Import%2314
msgid "Import using:"
msgstr "Importieren mit:"

#: Import%2315
msgid "Wrap lines:"
msgstr "Zeilenumbruch:"

#: Import%2316
msgid ""
"<p>Should pandoc create\n"
"                        cosmetic / non-semantic line-breaks?</p><p>\n"
"                        <b>auto</b>: wraps at 72 characters.<br>\n"
"                        <b>none</b>: no line wrap.<br>\n"
"                        <b>preserve</b>: tries to preserves line wrap from "
"the\n"
"                        original document.</p>"
msgstr ""
"<p>Soll pandoc\n"
"                        jede einzelne Zeile umbrechen?</p><p>\n"
"                        <b>auto</b>: bricht nach 72 Zeichen um.<br>\n"
"                        <b>none</b>: keine Zeilenumbrüche.<br>\n"
"                        <b>preserve</b>: versucht, Umbrüche aus dem "
"Originaldokument zu erhalten.</p>"

