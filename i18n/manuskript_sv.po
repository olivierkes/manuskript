#: Import%231
msgid "Markdown import"
msgstr "Import av Markdown"

#: Import%232
msgid ""
"<b>Info:</b> A very simple\n"
"                        parser that will go through a markdown document and\n"
"                        create items for each titles.<br/>&nbsp;"
msgstr ""
"<b>Info:</b> En väldigt enkel\n"
"                        tolk som kommer att gå genom ett Markdown-dokument\n"
"                        och skapar objekt för varje titel.<br/>&nbsp;"

#: Import%233
msgid "Folder import"
msgstr "Import av mappar"

#: Import%234
msgid ""
"<p><b>Info:</b> Imports a whole\n"
"                        directory structure. Folders are added as folders, "
"and\n"
"                        plaintext documents within (you chose which ones by "
"extension)\n"
"                        are added as scene.</p>\n"
"                        <p>Only text files are supported (not images, binary "
"or others).</p>"
msgstr ""
"<p><b>Info:</b> Importerar en hel\n"
"                        katalogstruktur. Mappar läggs till som mappar, och\n"
"                        vanliga textdokument inuti (du väljer vilka efter "
"filändelse)\n"
"                        läggs till som scener.</p>\n"
"                        <p>Endast textfiler stöds (inte bilder, binärer "
"eller annat).</p>"

#: Import%235
msgid "Include only those extensions:"
msgstr "Inkludera endast dessa filändelserna:"

#: Import%236
#, fuzzy
msgid "Comma separated values"
msgstr "Kommasepareradevärden"

#: Import%237
msgid "Sort items by name"
msgstr "Sortera objekt efter namn"

#: Import%238
msgid "Import folder then files"
msgstr "Importera mapp och sedan filer"

#: Import%239
msgid "OPML Import"
msgstr "OPML-import"

#: Import%2310
msgid "File open failed."
msgstr "Misslyckades med att öppna fil."

#: Import%2311
msgid "This does not appear to be a valid OPML file."
msgstr "Detta verkar inte vara en giltig OPML-fil."

#: Import%2312
msgid "Pandoc import"
msgstr "Pandoc-import"

#: Import%2313
msgid ""
"<b>Info:</b> Manuskript can\n"
"                        import from <b>markdown</b> or <b>OPML</b>. Pandoc "
"will\n"
"                        convert your document to either (see option below), "
"and\n"
"                        then it will be imported in manuskript. One or the "
"other\n"
"                        might give better result depending on your "
"document.\n"
"                        <br/>&nbsp;"
msgstr ""
"<b>Info:</b> Manuskript kan\n"
"                        importera från <b>markdown</b> eller <b>OPML</b>. "
"Pandoc kommer att\n"
"                        konvertera ditt dokument till endera (se alterntiv "
"nedan), och\n"
"                        sedan kommer det att importeras i manuskript. Endera "
"kan ge\n"
"                        bättre resultat beroende på ditt dokument.\n"
"                        <br/>&nbsp;"

#: Import%2314
msgid "Import using:"
msgstr "Importera via:"

#: Import%2315
msgid "Wrap lines:"
msgstr "Radbryt rader:"

#: Import%2316
msgid ""
"<p>Should pandoc create\n"
"                        cosmetic / non-semantic line-breaks?</p><p>\n"
"                        <b>auto</b>: wraps at 72 characters.<br>\n"
"                        <b>none</b>: no line wrap.<br>\n"
"                        <b>preserve</b>: tries to preserves line wrap from "
"the\n"
"                        original document.</p>"
msgstr ""
"<p>Ska pandoc skapa\n"
"                        kosmetiska / icke-semantiska radbrytningar?</p><p>\n"
"                        <b>auto</b>: radbryter efter 72 tecken.<br>\n"
"                        <b>none</b>: inga radbrytningar.<br>\n"
"                        <b>preserve</b>: försöker att bevara radbrytningar "
"från\n"
"                        originaldokumentet.</p>"

