#: Import%231
msgid "Markdown import"
msgstr "استيراد مارك داون (Markdown)"

#: Import%232
msgid ""
"<b>Info:</b> A very simple\n"
"                        parser that will go through a markdown document and\n"
"                        create items for each titles.<br/>&nbsp;"
msgstr ""
"<b>معلومات:</b> بسيط جداً\n"
"                        معالج يأخذ مستند مارك داون (markdown) و\n"
"                        ينشأ عناصر لكل العناوين.<br/>&nbsp;"

#: Import%233
msgid "Folder import"
msgstr "إستيراد مجلد"

#: Import%234
msgid ""
"<p><b>Info:</b> Imports a whole\n"
"                        directory structure. Folders are added as folders, "
"and\n"
"                        plaintext documents within (you chose which ones by "
"extension)\n"
"                        are added as scene.</p>\n"
"                        <p>Only text files are supported (not images, binary "
"or others).</p>"
msgstr ""
"<p><b>معلومات:</b> يستورد \n"
"                        مجلد بصيغتة الكاملة حيث تُضاف المجلدات كمجلدات، و\n"
"                        والمستندات النصية ضمنها (تحددها بواسطة نوع إمتداد "
"الملف)\n"
"                        تضاف كمشاهد.</p>\n"
"                        <p>فقط الملفات النصية مدعومة (الصور والملفات الأخرى "
"ليست مدعومة).</p>"

#: Import%235
msgid "Include only those extensions:"
msgstr "ضمن فقط هذه الإمتدادات:"

#: Import%236
msgid "Comma separated values"
msgstr "قيم مفصولة بفاصلة"

#: Import%237
msgid "Sort items by name"
msgstr "رتب العناصر بالاسم"

#: Import%238
msgid "Import folder then files"
msgstr "استورد مجلد ثم الملفات"

#: Import%239
msgid "OPML Import"
msgstr "استيراد OPML"

#: Import%2310
msgid "File open failed."
msgstr "فشل بفتح الملف."

#: Import%2311
msgid "This does not appear to be a valid OPML file."
msgstr "هذا لا يبدو أنه ملف OPML صالح."

#: Import%2312
msgid "Pandoc import"
msgstr "استيراد Pandoc"

#: Import%2313
msgid ""
"<b>Info:</b> Manuskript can\n"
"                        import from <b>markdown</b> or <b>OPML</b>. Pandoc "
"will\n"
"                        convert your document to either (see option below), "
"and\n"
"                        then it will be imported in manuskript. One or the "
"other\n"
"                        might give better result depending on your "
"document.\n"
"                        <br/>&nbsp;"
msgstr ""
"<b>معلومات:</b> يمكن لمانيوسكربت \n"
"                        الاستيراد من صيغ <b>مارك داون</b> أو <b>OPML</b>. "
"سيقوم Pandoc \n"
"                        بتحويل مستندك لأحدها (راجع الخيار بالأسفل), و عندها\n"
"                        سيتم اسيترادها لمانيوسكربت. إحداها قد\n"
"                         ستعطيك نتائج أفضل بناءاً على مستندك .\n"
"                        <br/>&nbsp;"

#: Import%2314
msgid "Import using:"
msgstr "استيراد بإستخدام:"

#: Import%2315
msgid "Wrap lines:"
msgstr "إلتفاف السطور:"

#: Import%2316
msgid ""
"<p>Should pandoc create\n"
"                        cosmetic / non-semantic line-breaks?</p><p>\n"
"                        <b>auto</b>: wraps at 72 characters.<br>\n"
"                        <b>none</b>: no line wrap.<br>\n"
"                        <b>preserve</b>: tries to preserves line wrap from "
"the\n"
"                        original document.</p>"
msgstr ""
"<p>هل يجب ل pandoc أن ينشأ\n"
"                         مساحات جمالية بين الفقرات؟</p><p>\n"
"                        <b>تلقائي</b>: إلتفاف للسطر بعد 72 حرف.<br>\n"
"                        <b>لاشيء</b>: بدون إلتفات للسطر.<br>\n"
"                        <b>محافظ</b>:يحاول أن يحتفظ بإلتفات السطور من\n"
"                        المستند الأصلي.</p>"

