#: Import%233
msgid "Folder import"
msgstr "Mappa importálása"

#: Import%234
msgid ""
"<p><b>Info:</b> Imports a whole\n"
"                        directory structure. Folders are added as folders, "
"and\n"
"                        plaintext documents within (you chose which ones by "
"extension)\n"
"                        are added as scene.</p>\n"
"                        <p>Only text files are supported (not images, binary "
"or others).</p>"
msgstr ""
"<p><b>Infó:</b> Teljes mappastruktúra importálása.\n"
"                        A mappák mappaként adódnak hozzá, és az azokban lévő "
"\n"
"                        egyszerű szöveges dokumentumok  (kiválaszthatja "
"melyek, kiterjesztés alapján)\n"
"                        pedig, mint jelentek adódnak hozzá..</p>\n"
"                        <p>Csak szövegfájlokat támogat (sem képeket, sem "
"bináris állományokat vagy egyebet nem támogat).</p>"

